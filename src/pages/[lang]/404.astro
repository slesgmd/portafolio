---
// Cloudflare sirve el `404.html` más cercano subiendo por la ruta
// (`not_found_handling: "404-page"`, §5.7).
import type { GetStaticPaths } from 'astro';
import { locales, messages, pathFor, siteName, type Locale } from '../../i18n';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const t = messages(locale);
---

<Base locale={locale} title={`${t.notFound.title} · ${siteName}`} description={t.notFound.body}>
  <h1>{t.notFound.heading}</h1>
  <p>{t.notFound.body}</p>
  <p>
    <a href={pathFor(locale, { kind: 'home' })}>{t.notFound.home}</a>
  </p>
</Base>
