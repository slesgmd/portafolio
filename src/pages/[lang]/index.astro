---
import type { GetStaticPaths } from 'astro';
import ToolList from '../../components/ToolList.astro';
import {
  editorial,
  locales,
  messages,
  pathFor,
  siteName,
  type Locale,
  type Route,
} from '../../i18n';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = (() =>
  locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const t = messages(locale);
const content = editorial(locale);
const route: Route = { kind: 'home' };
---

<Base locale={locale} title={siteName} description={content.description} route={route}>
  <h1>{siteName}</h1>
  <p>{content.home.lead}</p>
  <ToolList locale={locale} />
  <p>
    <a href={pathFor(locale, { kind: 'tools' })}>{t.home.toolsLink}</a>
  </p>
  <p>
    {content.home.intro} <a href={pathFor(locale, { kind: 'about' })}>{t.home.aboutLink}</a>.
  </p>
</Base>
