---
import type { GetStaticPaths } from 'astro';
import {
  editorial,
  locales,
  messages,
  segments,
  siteName,
  type Locale,
  type Route,
} from '../../../i18n';
import Base from '../../../layouts/Base.astro';

export const getStaticPaths = (() =>
  locales.map((lang) => ({
    params: { lang, about: segments.about[lang] },
  }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const t = messages(locale);
const content = editorial(locale);
const route: Route = { kind: 'about' };
---

<Base
  locale={locale}
  title={`${t.about.title} · ${siteName}`}
  description={content.description}
  route={route}
>
  <h1>{t.about.heading}</h1>
  <p>{content.about.intro}</p>
  <p>{content.about.motivation}</p>
  <p>{content.about.stack}</p>
  <p>
    {content.about.code} <a href="https://github.com/slesgmd">slesgmd</a>.
  </p>
</Base>
