---
import type { GetStaticPaths } from 'astro';
import { locales, messages, segments, siteName, type Locale, type Route } from '../../../i18n';
import Base from '../../../layouts/Base.astro';

export const getStaticPaths = (() =>
  locales.map((lang) => ({
    params: { lang, about: segments.about[lang] },
  }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const t = messages(locale);
const route: Route = { kind: 'about' };
---

<Base
  locale={locale}
  title={`${t.about.title} · ${siteName}`}
  description={t.site.description}
  route={route}
>
  <h1>{t.about.heading}</h1>
  <p>{t.about.intro}</p>
  <p>{t.about.motivation}</p>
  <p>{t.about.stack}</p>
  <p>
    {t.about.code} <a href="https://github.com/slesgmd">slesgmd</a>.
  </p>
</Base>
