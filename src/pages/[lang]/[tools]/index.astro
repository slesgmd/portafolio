---
import type { GetStaticPaths } from 'astro';
import ToolList from '../../../components/ToolList.astro';
import { locales, messages, segments, siteName, type Locale, type Route } from '../../../i18n';
import Base from '../../../layouts/Base.astro';
import { tools } from '../../../registry';

export const getStaticPaths = (() =>
  locales.map((lang) => ({
    params: { lang, tools: segments.tools[lang] },
  }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as Locale;
const t = messages(locale);
const route: Route = { kind: 'tools' };
---

<Base
  locale={locale}
  title={`${t.tools.title} · ${siteName}`}
  description={t.tools.description}
  route={route}
>
  <h1>{t.tools.heading}</h1>
  {tools.length === 0 ? <p>{t.tools.empty}</p> : <ToolList locale={locale} />}
</Base>
