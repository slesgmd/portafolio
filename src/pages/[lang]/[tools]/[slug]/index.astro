---
import type { GetStaticPaths } from 'astro';
import { locales, messages, segments, type Locale, type Route } from '../../../../i18n';
import Base from '../../../../layouts/Base.astro';
import { textsFor, tools, type ToolEntry } from '../../../../registry';

type ToolComponent = (props: { locale: Locale }) => unknown;

const interfaces = import.meta.glob<{ default: ToolComponent }>(
  '../../../../tools/*/ui/Tool.astro',
  { eager: true },
);

export const getStaticPaths = (() =>
  locales.flatMap((lang) =>
    tools.map((entry) => ({
      params: { lang, tools: segments.tools[lang], slug: entry.meta.slug },
      props: { entry },
    })),
  )) satisfies GetStaticPaths;

interface Props {
  entry: ToolEntry;
}

const { entry } = Astro.props;
// `ui/` no importa `meta.ts`: la estrategia de carga le llega en `data-hydration` (ADR 0005).
const { slug, hydration } = entry.meta;
const locale = Astro.params.lang as Locale;
const t = messages(locale);
const texts = textsFor(entry, locale);
const route: Route = { kind: 'tool', slug };
const Tool = interfaces[`../../../../tools/${slug}/ui/Tool.astro`]?.default;
if (Tool === undefined) throw new Error(`tools/${slug}: falta ui/Tool.astro`);
---

<Base
  locale={locale}
  title={`${texts.name} · ${t.site.name}`}
  description={texts.description}
  route={route}
>
  <h1>{texts.name}</h1>
  <div data-tool={slug} data-hydration={hydration}>
    <Tool locale={locale} />
  </div>
</Base>
