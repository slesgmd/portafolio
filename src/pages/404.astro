---
// 404 raíz (PLAN §5.7): cubre las rutas sin prefijo de idioma y es bilingüe. El
// documento está en el idioma por defecto; cada texto en otro idioma declara el suyo.
import { defaultLocale, locales, messages, pathFor } from '../i18n';
import Base from '../layouts/Base.astro';

const t = messages(defaultLocale);
const title = locales.map((locale) => messages(locale).notFound.title).join(' · ');
---

<Base locale={defaultLocale} title={title} description={t.notFound.body}>
  <main>
    <h1>
      {locales.map((locale, i) => (
        <>
          {i > 0 && ' · '}
          <span lang={locale}>{messages(locale).notFound.heading}</span>
        </>
      ))}
    </h1>
    {locales.map((locale) => {
      const m = messages(locale);
      return (
        <section lang={locale}>
          <p>{m.notFound.body}</p>
          <p>
            <a href={pathFor(locale, { kind: 'home' })}>{m.notFound.home}</a>
          </p>
        </section>
      );
    })}
  </main>
</Base>
