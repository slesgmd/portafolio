---
import { messages, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const t = messages(Astro.props.locale);
---

<footer class="footer">
  <p>
    © Sebastián Lescano · <a href="https://github.com/slesgmd/portafolio">{t.footer.source}</a>
  </p>
</footer>

<style>
  @layer components {
    .footer {
      padding-block: var(--space-m);
      padding-inline: max(var(--space-s), (100% - var(--page-max)) / 2);
      border-block-start: 1px solid var(--color-border);
      color: var(--color-text-muted);
      font-size: var(--step--1);
    }
  }
</style>
