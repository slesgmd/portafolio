---
// Las 404 no tienen ruta: enlazan al inicio del otro idioma.
import { alternatesFor, locales, messages, type Locale, type Route } from '../i18n';

interface Props {
  locale: Locale;
  route?: Route | undefined;
}

const { locale, route } = Astro.props;
const t = messages(locale);
const alternates = alternatesFor(route ?? { kind: 'home' });
const others = locales.filter((other) => other !== locale);
---

<nav aria-label={t.langSwitch.label}>
  {others.map((other) => (
    <a href={alternates[other]} hreflang={other} lang={other}>
      {messages(other).langSwitch.name}
    </a>
  ))}
</nav>
