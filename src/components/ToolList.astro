---
import { messages, pathFor, type Locale } from '../i18n';
import { textsFor, tools } from '../registry';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages(locale);
---

{tools.length > 0 && (
  <ul class="tools">
    {tools.map((entry) => {
      const texts = textsFor(entry, locale);
      return (
        <li>
          <a href={pathFor(locale, { kind: 'tool', slug: entry.meta.slug })}>{texts.name}</a>
          {entry.meta.status === 'beta' && <span class="status">{t.tools.beta}</span>}
          <p>{texts.description}</p>
        </li>
      );
    })}
  </ul>
)}

<style>
  @layer components {
    .tools {
      display: grid;
      gap: var(--space-m);
      padding: 0;
      list-style: none;
    }

    .tools a {
      font-family: var(--font-heading);
      font-weight: 600;
    }

    .status {
      margin-inline-start: var(--space-2xs);
      padding-inline: var(--space-3xs);
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-s);
      color: var(--color-text-muted);
      font-size: var(--step--1);
    }
  }
</style>
