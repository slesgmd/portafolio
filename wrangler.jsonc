// Sin código de Worker, solo assets (ADR 0003).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portafolio",
  // Fecha de la versión de workerd que trae la versión fijada de wrangler.
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    // 404 por idioma (§5.7).
    "not_found_handling": "404-page",
    // Es el valor por defecto; se fija de forma explícita (§5.7).
    "html_handling": "auto-trailing-slash",
  },
  // Sin dominio propio (§16, decisión 3).
  "workers_dev": true,
  // Vistas previas de los pasos 10 y 11.
  "preview_urls": true,
}
