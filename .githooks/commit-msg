#!/bin/sh
# PLAN §12, ADR 0005. Los términos van con clases de caracteres para que la comprobación
# de procedencia no detecte este archivo, y deben coincidir con los de
# scripts/check-provenance.ts.
set -eu

msg_file=$1
names='[c]laude|[a]nthropic'
types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
max_subject=100

cc=$(git config --get core.commentChar || true)
case $cc in
  ? ) ;;
  * ) cc='#' ;;
esac
scissors="$cc ------------------------ >8 ------------------------"

# Elimina las líneas de atribución. Los comentarios y lo que sigue a la línea de tijera
# (`git commit -v`) se conservan porque git los descarta después.
tmp="$msg_file.tmp.$$"
awk -v names="$names" -v cc="$cc" -v scissors="$scissors" '
  BEGIN { links = "(" names ")[.](ai|com)" }
  { sub(/\r$/, "") }
  cut || index($0, cc) == 1 { if ($0 == scissors) cut = 1; print; next }
  {
    low = tolower($0)
    if (low ~ /^[[:space:]]*co-authored-by:/ ||
        low ~ /^[^[:alnum:]]*generated (with|by)[[:space:]]/ ||
        low ~ links) {
      print "commit-msg: línea eliminada: " $0 > "/dev/stderr"
      next
    }
    print
  }
' "$msg_file" > "$tmp"
mv "$tmp" "$msg_file"

body=$(awk -v cc="$cc" -v scissors="$scissors" '
  $0 == scissors { exit }
  index($0, cc) == 1 { next }
  { print }
' "$msg_file")
subject=$(printf '%s\n' "$body" | awk 'NF { print; exit }')

# Se aceptan también los commits de autosquash y los de fusión.
if ! printf '%s\n' "$subject" | grep -Eq "^(fixup|squash|amend)! |^Merge "; then
  if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^ ]"; then
    echo "commit-msg: el asunto no sigue Conventional Commits: '$subject'" >&2
    echo "  Formato: tipo(ámbito opcional): descripción" >&2
    echo "  Tipos: $(echo "$types" | sed 's/|/, /g')" >&2
    exit 1
  fi
  length=$(printf '%s' "$subject" | awk '{ print length($0) }')
  if [ "$length" -gt "$max_subject" ]; then
    echo "commit-msg: el asunto tiene $length caracteres; el máximo es $max_subject." >&2
    exit 1
  fi
fi

if printf '%s\n' "$body" | grep -iEq "$names"; then
  echo "commit-msg: el mensaje nombra al asistente de código o a su proveedor (AGENTS.md):" >&2
  printf '%s\n' "$body" | grep -inE "$names" >&2
  exit 1
fi
