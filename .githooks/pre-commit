#!/bin/sh
# PLAN §12, ADR 0005. Revisa la copia de trabajo de cada archivo preparado, no la
# versión preparada: reescribir archivos preparados en parte mezclaría cambios. La
# compuerta que bloquea es el paso 3 de la CI.
set -eu

prettier=node_modules/prettier/bin/prettier.cjs
eslint=node_modules/eslint/bin/eslint.js
vitest=node_modules/vitest/vitest.mjs

if [ ! -f "$prettier" ] || [ ! -f "$eslint" ] || [ ! -f "$vitest" ]; then
  echo "pre-commit: faltan las dependencias; ejecuta 'pnpm install'." >&2
  exit 1
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -n "$staged" ]; then
  set --
  while IFS= read -r file; do
    set -- "$@" "$file"
  done <<LIST
$staged
LIST
  if ! node "$prettier" --check --ignore-unknown --log-level warn "$@"; then
    echo "pre-commit: hay archivos sin formatear; ejecuta 'pnpm format'." >&2
    exit 1
  fi

  set --
  while IFS= read -r file; do
    case $file in
      *.js | *.mjs | *.cjs | *.ts | *.astro) set -- "$@" "$file" ;;
    esac
  done <<LIST
$staged
LIST
  if [ $# -gt 0 ]; then
    node "$eslint" --max-warnings 0 --no-warn-ignored "$@"
  fi
fi

# En Windows, el sh de Git convertiría `/domain/` en una ruta absoluta.
MSYS_NO_PATHCONV=1 node "$vitest" run --passWithNoTests src/core/ /domain/
