# PLAN §7, ADR 0004. Cloudflare suma las reglas que coinciden con una petición y une con
# coma los valores de una cabecera repetida.

/*
  # Capa 2: solo `frame-ancestors`, que una CSP en `<meta>` ignora. Sin directivas de
  # recursos: bloquearían los scripts que la `<meta>` autoriza por hash.
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  # Mientras no haya dominio propio, todo el tráfico llega por `workers.dev` o por URL de
  # versión (§16, decisión 3). Sin `Strict-Transport-Security` hasta entonces.
  X-Robots-Tag: noindex
  # Sin `Cache-Control`: el HTML usa el valor por defecto de Cloudflare, y uno aquí se
  # uniría con coma al de `/_astro/*`.

# Carpeta de `build.assets`.
/_astro/*
  # Capa 3: los workers dedicados y el service worker aplican la CSP de la respuesta de
  # su script, no la del documento. En los demás scripts no tiene efecto.
  Content-Security-Policy: default-src 'self'; connect-src 'none'
  Cache-Control: public, max-age=31536000, immutable
